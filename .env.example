# Supabase project's Connect dialog (or Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL this app is served from — used to build the magic-link redirect.
# http://localhost:3000 for local dev; your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings -> Database -> Connection string (Session mode, port 5432)
# Only used locally to run `drizzle-kit push` — never used at runtime.
DIRECT_URL=
